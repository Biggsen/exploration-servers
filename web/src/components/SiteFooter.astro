---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-canvas py-14 text-mist">
  <div
    class="mx-auto grid max-w-[1200px] gap-10 px-4 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8"
  >
    <div class="space-y-2">
      <p class="font-display text-lg font-semibold text-fog">Exploration Servers</p>
      <p class="max-w-xs text-sm leading-relaxed text-dim">
        Exploration as progression — a hub for servers that make the world matter.
      </p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-dim">Site</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="#top" class="hover:text-fog">Home</a></li>
        <li><a href="#how-it-works" class="hover:text-fog">How It Works</a></li>
        <li><a href="#servers" class="hover:text-fog">Servers</a></li>
      </ul>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-dim">Servers</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="#servers" class="hover:text-fog">Charidh</a></li>
      </ul>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-dim">Community</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a href="#discord" class="hover:text-fog">Discord</a>
        </li>
      </ul>
    </div>
  </div>
  <p class="mt-10 text-center text-xs text-dim">
    © {year} Exploration Servers
  </p>
</footer>
