---
const systems = [
  {
    title: "Named world",
    body: "Every region has identity. Movement across the map feels like crossing real places.",
  },
  {
    title: "Discovery progression",
    body: "Regions, villages, and structures are tracked so exploration compounds over time.",
  },
  {
    title: "Meaningful rewards",
    body: "XP, claim blocks, and achievements reward what you find — not just what you farm.",
  },
  {
    title: "Persistent world",
    body: "Discoveries accumulate. The world becomes a record of where you’ve been.",
  },
];
---

<section
  class="border-b border-white/5 bg-canvas py-14 md:py-[4.5rem] lg:py-24"
  aria-labelledby="systems-title"
>
  <div class="mx-auto max-w-[1000px] px-4 sm:px-6 lg:px-8">
    <h2
      id="systems-title"
      class="text-center font-display text-3xl font-semibold leading-tight text-fog md:text-[28px] md:leading-[1.15]"
    >
      Core systems
    </h2>
    <p class="mx-auto mt-3 max-w-[640px] text-center text-base leading-relaxed text-mist">
      The supporting ideas behind the loop — concise, readable, grounded.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        systems.map((s) => (
          <article class="flex h-full flex-col rounded-[18px] border border-white/10 bg-elevated/85 p-8 shadow-sm backdrop-blur-sm">
            <h3 class="font-display text-xl font-semibold text-fog">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-mist">{s.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
