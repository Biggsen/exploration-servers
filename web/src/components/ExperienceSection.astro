---
const steps = [
  { n: 1, title: "Spawn", desc: "Enter a persistent world built for distance." },
  { n: 2, title: "Choose a direction", desc: "Pick a heading — the map is the objective." },
  { n: 3, title: "Enter a region", desc: "Cross into named territory with its own identity." },
  { n: 4, title: "Discover a location", desc: "Villages, structures, and landmarks worth finding." },
  { n: 5, title: "Earn rewards", desc: "XP, claim blocks, achievements — tied to discovery." },
  { n: 6, title: "Progress is recorded", desc: "Your journey accumulates; nothing is a throwaway find." },
  { n: 7, title: "Keep exploring", desc: "The loop repeats — open-ended, scalable, repeatable." },
];
---

<section
  id="how-it-works"
  class="relative overflow-hidden border-b border-white/5 bg-canvas py-14 md:py-[4.5rem] lg:py-24"
  aria-labelledby="experience-title"
>
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.04]"
    aria-hidden="true"
    style="background-image: linear-gradient(rgba(194,168,120,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(194,168,120,0.5) 1px, transparent 1px); background-size: 64px 64px;"
  >
  </div>

  <div class="relative mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
    <div class="max-w-[760px]">
      <h2
        id="experience-title"
        class="font-display text-3xl font-semibold leading-tight text-fog md:text-[28px] md:leading-[1.15]"
      >
        The experience
      </h2>
      <p class="mt-3 text-base leading-relaxed text-mist">
        A gameplay loop built around travel and discovery — not a feature list.
      </p>
    </div>

    <div class="mt-10 hidden lg:block">
      <div class="grid grid-cols-4 gap-4">
        {
          steps.slice(0, 4).map((s) => (
            <article class="rounded-[12px] border border-white/10 bg-elevated/85 p-5 shadow-sm backdrop-blur-sm">
              <p class="text-xs font-semibold uppercase tracking-wider text-gilt/90">Step {s.n}</p>
              <h3 class="mt-2 font-display text-lg font-semibold text-fog">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-mist">{s.desc}</p>
            </article>
          ))
        }
      </div>
      <div class="mt-4 flex flex-wrap justify-center gap-4">
        {
          steps.slice(4).map((s) => (
            <article class="w-full max-w-[260px] rounded-[12px] border border-white/10 bg-elevated/85 p-5 shadow-sm backdrop-blur-sm sm:w-[calc(33.333%-0.75rem)]">
              <p class="text-xs font-semibold uppercase tracking-wider text-gilt/90">Step {s.n}</p>
              <h3 class="mt-2 font-display text-lg font-semibold text-fog">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-mist">{s.desc}</p>
            </article>
          ))
        }
      </div>
    </div>

    <ol class="mt-10 space-y-4 lg:hidden">
      {
        steps.map((s) => (
          <li class="flex gap-4 rounded-[12px] border border-white/10 bg-elevated/85 p-5">
            <span
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-gilt/40 text-sm font-semibold text-gilt"
              aria-hidden="true"
            >
              {s.n}
            </span>
            <div>
              <h3 class="font-display text-lg font-semibold text-fog">{s.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-mist">{s.desc}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
