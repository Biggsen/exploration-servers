---
import ButtonLink from "./ButtonLink.astro";
---

<header
  id="site-header"
  class="fixed top-0 z-50 w-full border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-200 ease-out"
  data-scrolled="false"
>
  <div
    class="mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-4 px-4 sm:px-6 lg:h-[72px] lg:px-8"
  >
    <a
      href="#top"
      class="font-display text-lg font-semibold tracking-tight text-fog transition-colors duration-200 hover:text-white"
    >
      Exploration Servers
    </a>

    <nav
      class="hidden items-center gap-8 text-[15px] font-medium text-mist lg:flex"
      aria-label="Primary"
    >
      <a href="#top" class="transition-colors duration-200 hover:text-fog">Home</a>
      <a href="#how-it-works" class="transition-colors duration-200 hover:text-fog"
        >How It Works</a
      >
      <a href="#servers" class="transition-colors duration-200 hover:text-fog">Servers</a>
      <a href="#discord" class="transition-colors duration-200 hover:text-fog">Discord</a>
      <ButtonLink href="#servers" variant="primary" class="ml-2 shrink-0 px-4 py-2">
        Explore Servers
      </ButtonLink>
    </nav>

    <button
      type="button"
      id="menu-toggle"
      class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-mist/25 text-fog transition-colors hover:bg-white/5 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <span class="sr-only">Menu</span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M4 7h16M4 12h16M4 17h16"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-white/10 bg-canvas/98 px-4 py-4 backdrop-blur-md lg:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
  >
    <nav class="flex flex-col gap-3 text-[15px] font-medium text-mist">
      <a href="#top" class="rounded-md px-2 py-2 hover:bg-white/5 hover:text-fog">Home</a>
      <a href="#how-it-works" class="rounded-md px-2 py-2 hover:bg-white/5 hover:text-fog"
        >How It Works</a
      >
      <a href="#servers" class="rounded-md px-2 py-2 hover:bg-white/5 hover:text-fog">Servers</a>
      <a href="#discord" class="rounded-md px-2 py-2 hover:bg-white/5 hover:text-fog">Discord</a>
      <ButtonLink href="#servers" variant="primary" class="mt-2 w-full text-center">
        Explore Servers
      </ButtonLink>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const panel = document.getElementById("mobile-menu");

  const setScrolled = () => {
    if (!header) return;
    const y = window.scrollY;
    const pastHero = y > 48;
    header.dataset.scrolled = pastHero ? "true" : "false";
    if (pastHero) {
      header.classList.add(
        "border-white/10",
        "bg-canvas/92",
        "backdrop-blur-md",
        "shadow-[0_1px_0_rgba(255,255,255,0.04)]",
      );
    } else {
      header.classList.remove(
        "border-white/10",
        "bg-canvas/92",
        "backdrop-blur-md",
        "shadow-[0_1px_0_rgba(255,255,255,0.04)]",
      );
    }
  };

  setScrolled();
  window.addEventListener("scroll", setScrolled, { passive: true });

  const closeMenu = () => {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", "false");
    panel.classList.add("hidden");
    document.body.style.overflow = "";
  };

  toggle?.addEventListener("click", () => {
    if (!toggle || !panel) return;
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", open ? "false" : "true");
    panel.classList.toggle("hidden", open);
    document.body.style.overflow = open ? "" : "hidden";
    toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
  });

  panel?.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });
</script>
