---
const pillars = [
  {
    title: "Named regions",
    body: "Regions structure the world and give every journey a sense of place.",
  },
  {
    title: "Tracked discoveries",
    body: "Villages, structures, and locations you find are remembered — not one-off set dressing.",
  },
  {
    title: "Exploration-based progression",
    body: "Advancement is tied to moving through the world, not only to grinding resources.",
  },
];
---

<section
  class="border-b border-line/60 bg-parchment py-14 md:py-[4.5rem] lg:py-24"
  aria-labelledby="concept-title"
>
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
      <div>
        <h2
          id="concept-title"
          class="font-display text-3xl font-semibold leading-tight text-ink md:text-[28px] md:leading-[1.15]"
        >
          What this changes
        </h2>
        <p class="mt-4 max-w-[560px] text-base leading-relaxed text-ink-body">
          <strong class="font-semibold text-ink">Exploration Servers</strong> turn discovery into
          progression — a structured exploration experience built on survival Minecraft.
        </p>
        <p
          class="mt-8 border-l-2 border-earth/70 pl-5 font-display text-xl italic leading-snug text-ink md:text-2xl"
        >
          You don’t just travel. You uncover the world.
        </p>
      </div>
      <div class="space-y-4">
        {
          pillars.map((p) => (
            <div class="rounded-[18px] border border-line bg-white/55 px-6 py-5 shadow-sm backdrop-blur-sm">
              <h3 class="text-lg font-semibold leading-tight text-ink">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-body">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
