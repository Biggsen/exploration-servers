---
import ButtonLink from "./ButtonLink.astro";
---

<section
  id="discord"
  class="border-b border-white/10 bg-canvas py-16 md:py-20 lg:py-24"
  aria-labelledby="final-cta-title"
>
  <div class="mx-auto max-w-[760px] px-4 text-center sm:px-6 lg:px-8">
    <h2
      id="final-cta-title"
      class="font-display text-3xl font-semibold leading-tight text-fog md:text-[28px] md:leading-[1.15]"
    >
      Start exploring
    </h2>
    <p class="mt-4 text-base leading-relaxed text-mist">
      Pick a server when you’re ready — or join the community for updates and onboarding.
    </p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
      <ButtonLink href="#servers" variant="primary">View servers</ButtonLink>
      <ButtonLink
        href="https://discord.gg/"
        variant="secondaryDark"
        rel="noopener noreferrer"
        target="_blank"
      >
        Join Discord
      </ButtonLink>
    </div>
  </div>
</section>
